# Public values only. Never put service-role keys or API secrets in the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Branding (name, colours, logo, support contact) comes from ../client/client.toml and is
# written into the build by scripts/sync-client.mjs. Set CLIENT_CONFIG_PATH to use another file.
CLIENT_CONFIG_PATH=
