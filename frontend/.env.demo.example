# Public demo build (Cloudflare Pages → Settings → Environment variables, Production).
# Public values only. Never put service-role keys or API secrets in the frontend.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_URL=https://bileksa-demo-api.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://your-DEMO-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-demo-project-anon-or-publishable-key
NODE_VERSION=22

# Branding (name, colours, logo, support contact) comes from ../client/client.toml and is
# written into the build by scripts/sync-client.mjs. Set CLIENT_CONFIG_PATH to use another file.
CLIENT_CONFIG_PATH=
